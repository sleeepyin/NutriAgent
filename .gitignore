# Generated
**/__pycache__/
*.pyc

# Datasets, weights, and the shared VLM cache.
# Directory placeholders and their READMEs stay tracked.
data/**
!data/**/
!data/**/README.md
weights/**
!weights/**/
!weights/**/README.md
cache/**
!cache/**/
!cache/**/README.md

# The same local copies live under backup/ and are not in the paths above.
backup/**/data/**
backup/**/weights/**

# Large artifacts outside those trees
**/*.pth
**/*.pt
**/*.onnx
**/*.ckpt
**/*.npz
**/*.npy
**/*.pkl
*.zip
*.tar
*.tar.gz
*.7z

.venv/
